#!/bin/bash
# dmc-navigator-prod on-prem command. Thin wrapper around `docker compose run`
# for the license-gated image. Infra subcommands are handled by sibling scripts;
# anything else is forwarded straight to the in-container CLI.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SELF_DIR}/_compose-env"

show_help() {
  cat <<'EOF'
dmc-navigator-prod — on-prem

Setup / licensing:
  navigator login                     Assume the pull role and authenticate to ECR
  navigator pull                      Pull the container image
  navigator update                    Pull the image and report whether it changed
  navigator machine-id                Print this machine's license fingerprint
  navigator update-license <file>     Install a signed license file
  navigator verify-license            Verify the installed license

Databases (encrypted release bundles; require a valid license + install key):
  navigator data catalog              List the databases you can install
  navigator data install <db[@rel]>   Download + decrypt + install a release
  navigator data list                 List installed releases
  navigator data verify <db@rel>      Re-verify an installed release (offline)
  navigator data remove <db@rel>      Delete an installed release from disk

Workflow (forwarded to the licensed CLI; require a valid license):
  navigator init  --run-dir runs/<name> --config-json inputs/<target>.json --overwrite
  navigator propose        --run-dir runs/<name>
  navigator ingest         --run-dir runs/<name> --scores <scores.csv>
  navigator update-params  --run-dir runs/<name> [--budget N ...]
  navigator transition     --run-dir runs/<name> --to analog_harvest_accurate
  navigator status         --run-dir runs/<name>
  navigator <cmd> --help              Show options for any workflow command

Warm start / enrichment (molecules you scored outside the propose-ingest loop):
  navigator warm-start --run-dir runs/<name> --scores inputs/seeds.csv [--dry-run]
                                      Seed a FRESH run before its first propose.
  navigator enrich     --run-dir runs/<name> --scores inputs/extra.csv
                                      Add evidence to a run already under way
                                      (between rounds; not mid-batch).
                                      --mode synthon  RECOMMENDED. Rows carry ids
                                        from the database being screened (a
                                        Navigator product_id, or reaction_id +
                                        synthon_ids). Navigator rebuilds the
                                        structures itself, so the molecules become
                                        full members of the run and are never
                                        re-docked at your expense.
                                      --mode smiles   Structures only. Warm-trains
                                        the ranking model; the next propose still
                                        draws its own fresh batch.
                                      --mode auto (default) picks per file.
                                      These molecules are CHARGED to the run's
                                      budget by default; pass --free if you do not
                                      want them to consume it.
                                      Always --dry-run a large file first.

Sampling (forwarded to the licensed CLI; requires a valid license):
  navigator random <N> --mode pw|rw --database <db@rel> --output <csv> [--seed N]
                                      Draw N distinct random molecules from a
                                      space to an id,smiles CSV. pw = each
                                      product equally likely (uniform over the
                                      space); rw = each reaction equally likely
                                      (favours scaffold diversity). Add
                                      --filter-profile druglike-v1 to sample the
                                      drug-like subset.

Info (no license required):
  navigator roster                    List the available strategy presets
  navigator self-test                 Report runtime health (no proprietary data)

Housekeeping:
  navigator shell                     Open a shell in the image (debugging)
  navigator uninstall                 Remove the installed command + config (keeps this repo)
  navigator help                      This message
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  -h|--help|help) show_help ;;
  login)          exec "${SELF_DIR}/login" "$@" ;;
  pull)           exec "${SELF_DIR}/pull" "$@" ;;
  update)         exec "${SELF_DIR}/update" "$@" ;;
  machine-id)     exec "${SELF_DIR}/machine-id" "$@" ;;
  update-license) exec "${SELF_DIR}/update-license" "$@" ;;
  verify-license) exec "${SELF_DIR}/verify-license" "$@" ;;
  uninstall)      exec "${SELF_DIR}/uninstall-navigator" "$@" ;;
  shell)          require_image || exit 1; exec $COMPOSE_CMD run --rm --entrypoint bash navigator "$@" ;;
  data)
                  # `data remove` is a purely local delete (no container, no
                  # license); everything else forwards to the in-container CLI,
                  # which fetches (network) and decrypts into the databases mount.
                  if [ "${1:-}" = "remove" ]; then
                    shift || true
                    exec "${SELF_DIR}/data-remove" "$@"
                  fi
                  require_image || exit 1
                  exec $COMPOSE_CMD run --rm navigator data "$@" ;;
  # Workflow/sampling commands and everything else → the in-container licensed CLI.
  init|propose|ingest|warm-start|enrich|update-params|transition|status|random|roster|self-test|*)
                  require_image || exit 1
                  exec $COMPOSE_CMD run --rm navigator "$cmd" "$@" ;;
esac
